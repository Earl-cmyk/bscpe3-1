# Copy to .env for local development. Set these in Render Environment Variables.
DATABASE_URL=replace-with-your-Supabase-Postgres-connection-string
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-secret
SUPABASE_STORAGE_BUCKET=uploads
TASK_PIN=replace-with-a-private-pin
